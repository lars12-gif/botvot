# Optional: absolute persistent path recommended by your hosting provider.
# Defaults are relative to the project directory.
DATA_DIR=./data
AUTH_DIR=./auth
LOG_LEVEL=info

# Pairing code is printed once to the private application console.
# Keep your hosting console private. Set false to suppress the code (then pairing
# cannot be completed until you enable it again).
PAIRING_CODE_TO_CONSOLE=true

# Connection tuning
RECONNECT_BASE_MS=1500
RECONNECT_MAX_MS=60000
CONNECT_TIMEOUT_MS=60000
KEEPALIVE_INTERVAL_MS=20000
